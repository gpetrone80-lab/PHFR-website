rules_version = '2';
// PHFR SOP & EMS Reference Hub — Firestore security rules.
//
// The app signs in anonymously (no passwords on Google's side), so every rule
// below requires a signed-in app session. Member PINs are verified client-side
// against salted SHA-256 hashes; the Admin Portal password never leaves the
// training captain's device.
//
// Collections used by the app:
//   phfr_profiles/{profileId}     — member profiles {id, name, salt, pinHash, created, seen}
//   phfr_results/{resultId}       — quiz attempts {id, profileId, date, category, total, correct, score, missed[], detail[], ...}
//   phfr_tombstones/{profileId}   — deletion markers so a removed member stays
//                                   removed on every device {id, type, pinHash, deletedAt}
//
// Trade-off to be aware of: any signed-in app session can READ all member
// profiles and quiz scores (this is what lets members sign in on a new device
// and what lets the Admin Portal show every member). PINs are salted hashes —
// the raw PIN never leaves the member's device. If you later need per-member
// privacy, add Firebase Authentication with custom admin claims and tighten
// these rules.
service cloud.firestore {
  match /databases/{database}/documents {

    match /phfr_profiles/{profileId} {
      allow read, create, update: if request.auth != null;
      // deletes go through tombstones so they propagate to every device
      allow delete: if request.auth != null;
    }

    match /phfr_results/{resultId} {
      allow read, create: if request.auth != null;
      // results are immutable once written (append-only history)
      allow update, delete: if false;
    }

    match /phfr_tombstones/{tombstoneId} {
      allow read, create, delete: if request.auth != null;
      allow update: if false;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
